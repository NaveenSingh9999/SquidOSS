{
  "name": "squidlab-sdk",
  "version": "1.1.0",
  "description": "Official SDK for building SquidCloud extensions with TypeScript, JavaScript, and React support",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "bin": {
    "squidlab-sdk": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "prepublishOnly": "npm run build",
    "cli": "node bin/cli.js"
  },
  "keywords": [
    "squidcloud",
    "extension",
    "sdk",
    "squidlab"
  ],
  "author": "SquidCloud Team",
  "license": "MIT",
  "peerDependencies": {
    "react": "^18.0.0"
  },
  "dependencies": {
    "commander": "^11.0.0",
    "inquirer": "^8.2.5",
    "chalk": "^4.1.2",
    "fs-extra": "^11.0.0",
    "archiver": "^6.0.0",
    "axios": "^1.6.0",
    "form-data": "^4.0.0",
    "express": "^4.18.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/node": "^20.0.0",
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-typescript": "^11.0.0",
    "rollup": "^3.0.0",
    "rollup-plugin-postcss": "^4.0.0",
    "typescript": "^5.0.0",
    "jest": "^29.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NaveenSingh9999/SquidCloud"
  },
  "bugs": {
    "url": "https://github.com/NaveenSingh9999/SquidCloud/issues"
  },
  "homepage": "https://squidcloud.inflate.live/"
}
