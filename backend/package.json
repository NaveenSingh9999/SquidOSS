{
  "name": "squidoss-backend",
  "version": "1.0.0",
  "description": "SquidOSS backend server - self-hosted cloud storage",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "build": "tsc",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "setup": "tsx scripts/setup.ts",
    "build:native": "mkdir -p build/Release && gcc -fPIC -shared -I\"$(node -e \"const{dirname,resolve}=require('node:path');console.log(resolve(dirname(process.execPath),'..','include','node'))\")\" src/native/local_storage.c -o build/Release/local_storage.node"
  },
  "keywords": [
    "squidoss",
    "cloud-storage",
    "self-hosted"
  ],
  "author": "",
  "license": "AGPL-3.0",
  "type": "module",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/jwt": "^10.1.0",
    "@fastify/multipart": "^10.0.0",
    "@simplewebauthn/server": "^13.3.1",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "ioredis": "^5.11.0",
    "jose": "^6.2.3",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  }
}
