# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/squidoss

# Redis (optional - enables caching, rate limiting, pub/sub)
REDIS_URL=redis://localhost:6379

# JWT Secrets
JWT_SECRET=replace-with-a-random-64-char-string
JWT_EXPIRES_IN=7d

# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# File Storage (S3-compatible)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=squidoss-files
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# Encryption
ENCRYPTION_KEY_SALT=replace-with-random-salt

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# CORS (comma-separated for multiple, or true for any origin in dev)
CORS_ORIGIN=http://localhost:5173

# Frontend API URL override (auto-detected on Codespaces)
# VITE_SQUIDOSS_API_URL=http://localhost:3000
